---
const navLinks = [
  { href: '/#projets', label: 'Projets et réalisations' },
  { href: '/#domaines', label: "Domaines d'intervention" },
  { href: '/#qui-sommes-nous', label: 'Qui sommes-nous' },
  { href: '/#impact', label: 'Notre impact' },
  { href: '/#actualites', label: 'Actualités et ressources' },
  { href: '/#don', label: 'Agir avec nous' },
];
---

<footer id="contact" class="footer">
  <div class="container">
    <div class="footer__grid" data-reveal-group>
      <div>
        <div class="footer__brand">
          <img src="/logo-inadec.jpg" alt="Logo INADEC" class="footer__logo" />
          <div class="footer__brand-name">INADEC</div>
        </div>
        <p class="footer__about">
          Initiative Nationale pour le Développement Communautaire — association apolitique, laïque et à but non
          lucratif, née de la volonté d'un collectif de sociologues, d'économistes, d'environnementalistes et de
          professionnels de la santé.
        </p>
        <div class="footer__socials">
          <a href="https://www.facebook.com/Inadec.2020" target="_blank" rel="noopener noreferrer" class="footer__social">Facebook</a>
          <a href="/#contact" class="footer__social">X · @ONGINADEC</a>
        </div>
      </div>

      <div>
        <div class="footer__heading">Navigation</div>
        <div class="footer__links">
          {navLinks.map((link) => (
            <a href={link.href} class="footer__link">{link.label}</a>
          ))}
        </div>
      </div>

      <div>
        <div class="footer__heading">Contact</div>
        <div class="footer__contact">
          <div>06 BP 1371 Abidjan 06<br />République de Côte d'Ivoire</div>
          <div>(+225) 07 07 88 37 82<br />(+225) 07 48 02 58 54</div>
          <div>inadec.ci@gmail.com</div>
        </div>
      </div>

      <div>
        <div class="footer__heading">Nous écrire</div>
        <p class="footer__form-intro">Pour toute demande d'information, de partenariat ou de collaboration.</p>
        <form class="footer__form" id="contact-form">
          <input type="hidden" name="access_key" value="19847850-7389-45b5-a663-57f01ec81c21" />
          <input type="checkbox" name="botcheck" class="footer__honeypot" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="subject" value="Nouveau message depuis le site INADEC" />

          <label class="sr-only" for="contact-name">Nom et organisation</label>
          <input class="footer__input" type="text" id="contact-name" name="name" placeholder="Nom et organisation" required />

          <label class="sr-only" for="contact-email">Adresse électronique</label>
          <input class="footer__input" type="email" id="contact-email" name="email" placeholder="Adresse électronique" required />

          <label class="sr-only" for="contact-message">Votre message</label>
          <textarea class="footer__input footer__textarea" id="contact-message" name="message" placeholder="Votre message" required></textarea>

          <button type="submit" class="footer__submit">Envoyer</button>
          <p class="footer__form-status" id="contact-form-status" role="status"></p>
        </form>
      </div>
    </div>

    <div class="footer__bottom">
      <div>
        © 2026 INADEC. Tous droits réservés. — Site web réalisé grâce au soutien du Fonds Canadien d'Initiatives
        Locales, FCIL 2026-2027, projet « Milieu scolaire et santé féminine ».
      </div>
      <div class="footer__legal">
        <a href="/#contact">Mentions légales</a>
        <a href="/#contact">Politique de confidentialité</a>
        <a href="/#contact">Plan du site</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-green-darkest);
    color: var(--color-cream);
    padding: 80px 48px 32px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(237, 242, 230, 0.16);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .footer__logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    background: var(--color-bg);
    border-radius: 50%;
    padding: 2px;
  }

  .footer__brand-name {
    font-weight: 700;
    font-size: 19px;
    color: var(--color-bg);
  }

  .footer__about {
    font-size: 14.5px;
    line-height: 1.65;
    opacity: 0.78;
    margin: 0 0 22px;
    max-width: 330px;
  }

  .footer__socials {
    display: flex;
    gap: 10px;
  }

  .footer__social {
    border: 1px solid rgba(237, 242, 230, 0.32);
    color: var(--color-cream);
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 2px;
    display: inline-block;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.3s var(--ease-out);
  }

  .footer__social:hover {
    background: var(--color-orange);
    color: var(--color-green-darkest);
    border-color: var(--color-orange);
    transform: translateY(-2px);
  }

  .footer__heading {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tan);
    margin-bottom: 18px;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 14.5px;
  }

  .footer__link {
    color: var(--color-cream);
    opacity: 0.8;
    display: inline-block;
    transition: color 0.2s ease, opacity 0.2s ease, transform 0.3s var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-tan);
    opacity: 1;
    transform: translateX(3px);
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14.5px;
    line-height: 1.5;
    opacity: 0.82;
  }

  .footer__form-intro {
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.78;
    margin: 0 0 16px;
  }

  .footer__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .footer__form-status {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.5;
    min-height: 1.2em;
  }

  .footer__form-status[data-state='success'] {
    color: var(--color-tan);
  }

  .footer__form-status[data-state='error'] {
    color: #e08585;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer__input {
    border: 1px solid rgba(237, 242, 230, 0.24);
    background: transparent;
    padding: 12px 14px;
    font-size: 13.5px;
    color: var(--color-cream);
    font-family: var(--font-sans);
    border-radius: 2px;
    transition: border-color 0.25s ease;
  }

  .footer__input::placeholder {
    color: rgba(237, 242, 230, 0.5);
  }

  .footer__input:focus {
    outline: none;
    border-color: var(--color-tan);
  }

  .footer__textarea {
    height: 56px;
    resize: vertical;
  }

  .footer__submit {
    background: var(--color-cream);
    color: var(--color-green-darkest);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
    padding: 13px 18px;
    text-align: center;
    border-radius: 2px;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.3s var(--ease-out);
  }

  .footer__submit:hover {
    background: var(--color-orange);
    transform: translateY(-2px);
  }

  .footer__submit:active {
    transform: translateY(0);
  }

  .footer__bottom {
    padding-top: 26px;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    font-size: 13px;
    opacity: 0.62;
  }

  .footer__legal {
    display: flex;
    gap: 20px;
  }

  .footer__legal a {
    color: var(--color-cream);
  }

  @media (max-width: 1000px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding: 56px 20px 24px;
    }

    .footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.footer__submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours…';
    status.removeAttribute('data-state');
    status.textContent = '';

    try {
      const payload = Object.fromEntries(new FormData(form).entries());
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (response.ok && result.success) {
        status.setAttribute('data-state', 'success');
        status.textContent = 'Message envoyé — nous vous répondrons rapidement.';
        form.reset();
      } else {
        throw new Error(result.message || 'Échec de l\'envoi');
      }
    } catch {
      status.setAttribute('data-state', 'error');
      status.textContent = "Une erreur est survenue. Réessayez ou écrivez-nous directement à inadec.ci@gmail.com.";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer';
    }
  });
</script>
